# Copy to _local/clipperz/config/clipperz.env. Replace C:/path/to/video-clipperz and every executable placeholder.
# Values are literal; environment-variable interpolation is not supported. No credentials belong here.
FFMPEG_PATH="C:/path/to/ffmpeg.exe"
FFPROBE_PATH="C:/path/to/ffprobe.exe"
NUMBA_CACHE_DIR="C:/path/to/video-clipperz/_local/clipperz/data/cache/numba"
PODCLI_AI_PROVIDER="codex-then-claude"
PODCLI_BACKEND="C:/path/to/video-clipperz/backend"
PODCLI_BROWSER="C:/path/to/chrome.exe"
PODCLI_CACHE_DIR="C:/path/to/video-clipperz/_local/clipperz/data/cache"
PODCLI_CLAUDE_PATH="C:/path/to/claude.exe"
PODCLI_CODEX_PATH="C:/path/to/codex.exe"
PODCLI_CWD="C:/path/to/video-clipperz/_local/clipperz/home"
PODCLI_DATA="C:/path/to/video-clipperz/_local/clipperz/data"
PODCLI_ENGINE="whisper-py"
PODCLI_ENV_FILE="C:/path/to/video-clipperz/_local/clipperz/config/clipperz.env"
PODCLI_HOME="C:/path/to/video-clipperz/_local/clipperz/home"
PODCLI_HOST="127.0.0.1"
PODCLI_INFERENCE_DIR="C:/path/to/video-clipperz/_local/clipperz/inference"
PODCLI_LOCAL_ONLY="1"
PODCLI_NODE="C:/path/to/node.exe"
PODCLI_OUTPUT="C:/path/to/video-clipperz/_local/clipperz/exports"
PODCLI_PORT="3847"
PODCLI_PYTHON="C:/path/to/video-clipperz/_local/clipperz/venv/Scripts/python.exe"
PYTHONDONTWRITEBYTECODE="1"
PYTHONIOENCODING="utf-8"
PYTHONUNBUFFERED="1"
PYTHONUTF8="1"
PYTHON_PATH="C:/path/to/video-clipperz/_local/clipperz/venv/Scripts/python.exe"
TEMP="C:/path/to/video-clipperz/_local/clipperz/tmp"
TMP="C:/path/to/video-clipperz/_local/clipperz/tmp"
TMPDIR="C:/path/to/video-clipperz/_local/clipperz/tmp"
TORCH_HOME="C:/path/to/video-clipperz/_local/clipperz/data/cache/torch"
XDG_CACHE_HOME="C:/path/to/video-clipperz/_local/clipperz/data/cache"
